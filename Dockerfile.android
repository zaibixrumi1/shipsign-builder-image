FROM ghcr.io/cirruslabs/android-sdk:36

ENV ANDROID_HOME=/opt/android-sdk-linux \
    ANDROID_SDK_ROOT=/opt/android-sdk-linux \
    GRADLE_USER_HOME=/root/.gradle \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl unzip zip cmake ninja-build && \
    rm -rf /var/lib/apt/lists/*

RUN yes | sdkmanager --licenses > /dev/null 2>&1 || true && \
    sdkmanager \
      "platform-tools" \
      "platforms;android-35" \
      "platforms;android-36.1" \
      "build-tools;36.0.0" \
      "cmake;3.22.1" \
      "ndk;28.2.13676358"

RUN curl -fsSL https://services.gradle.org/distributions/gradle-9.3.1-bin.zip -o /tmp/g.zip && \
    unzip -q /tmp/g.zip -d /opt && \
    rm /tmp/g.zip
ENV PATH="/opt/gradle-9.3.1/bin:${PATH}"

RUN mkdir -p /tmp/warmup && \
    printf 'rootProject.name = "warmup"\n' > /tmp/warmup/settings.gradle && \
    printf 'plugins { id "java" }\nrepositories { google(); mavenCentral(); gradlePluginPortal() }\ndependencies {\n  implementation platform("androidx.compose:compose-bom:2025.02.00")\n  implementation "androidx.compose.ui:ui"\n  implementation "androidx.compose.material3:material3"\n  implementation "androidx.activity:activity-compose:1.10.1"\n  implementation "androidx.lifecycle:lifecycle-viewmodel-compose:2.8.7"\n  implementation "androidx.browser:browser:1.8.0"\n  implementation "androidx.security:security-crypto:1.1.0-alpha06"\n  implementation "com.squareup.okhttp3:okhttp:4.12.0"\n  implementation "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.10.1"\n  implementation "com.android.tools.build:apksig:8.9.1"\n  implementation "com.android.tools.build:bundletool:1.18.3"\n}\n' > /tmp/warmup/build.gradle && \
    cd /tmp/warmup && \
    gradle wrapper --gradle-version 9.3.1 --no-daemon && \
    ./gradlew --version --no-daemon && \
    ./gradlew dependencies --configuration compileClasspath --no-daemon || true && \
    rm -rf /tmp/warmup /root/.gradle/daemon
